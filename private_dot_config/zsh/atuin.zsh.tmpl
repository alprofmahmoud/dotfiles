# ============================================
# Atuin - history backend, autosuggestions, widgets
# Sourced from ~/.zshrc (chezmoi template)
# ============================================
# Nothing to do if atuin is not installed
(( $+commands[atuin] )) || return 0

# --- Host id (used by the autosuggest strategy and the widgets) ---
{{- if eq .chezmoi.os "android" }}
export ATUIN_HOST_NAME="termux"
export ATUIN_HOST_USER="tmx-a24"
_ATUIN_HOST_ID="termux:tmx-a24"
{{- else }}
_ATUIN_HOST_ID="$(hostname):$(id -un)"
{{- end }}

# --- Autosuggestions strategy ---
# Priority (newest first inside each tier):
#   1) same host + same directory
#   2) same host, any directory
#   3) anything
_zsh_autosuggest_strategy_atuin_host() {
    emulate -L zsh
    local fs=$'\x1f'
    local result
    result=$(ATUIN_P="$1" ATUIN_H="${_ATUIN_HOST_ID%%:*}" ATUIN_D="$PWD" \
        atuin history list --reverse false \
        --format "{host}${fs}{directory}${fs}{command}" 2>/dev/null \
      | awk -F'\037' '
          BEGIN { p=ENVIRON["ATUIN_P"]; h=ENVIRON["ATUIN_H"]; d=ENVIRON["ATUIN_D"]; n=length(p) }
          NF==3 && length($3)>n && substr($3,1,n)==p {
              if ($1==h && $2==d) { print $3; found=1; exit }
              if ($1==h && !t2) t2=$3
              if (!t3) t3=$3
          }
          END { if (!found) { if (t2) print t2; else if (t3) print t3 } }')
    typeset -g suggestion="$result"
}
ZSH_AUTOSUGGEST_STRATEGY=(atuin_host)

# --- Init ---
# Keep atuin recording history, but don't let it bind Ctrl+R / Up
eval "$(atuin init zsh --disable-ctrl-r --disable-up-arrow)"

# --- Ctrl+R: fzf over atuin history, same-dir (+same-host) commands first ---
atuin-fzf-widget() {
    emulate -L zsh
    local fs=$'\x1f'
    local selected
    selected=$(ATUIN_H="${_ATUIN_HOST_ID%%:*}" ATUIN_D="$PWD" \
        atuin history list --reverse false \
        --format "{host}${fs}{directory}${fs}{command}" 2>/dev/null \
      | awk -F'\037' '
          BEGIN { h=ENVIRON["ATUIN_H"]; d=ENVIRON["ATUIN_D"] }
          NF==3 && length($3)>1 && $3 !~ /^#/ && $3 !~ /^ / && !seen[$3]++ {
              if ($1==h && $2==d) a[++na]=$3
              else if ($2==d)     b[++nb]=$3
              else if ($1==h)     c[++nc]=$3
              else                e[++ne]=$3
          }
          END {
              for (i=1;i<=na;i++) print a[i]
              for (i=1;i<=nb;i++) print b[i]
              for (i=1;i<=nc;i++) print c[i]
              for (i=1;i<=ne;i++) print e[i]
          }' \
      | fzf --height 50% \
            --layout=reverse \
            --border \
            --no-sort \
            --exact \
            --prompt="❯ History " \
            --query="$BUFFER"
    )
    if [[ -n "$selected" ]]; then
        BUFFER="$selected"
        CURSOR=${#BUFFER}
    fi
    zle reset-prompt
}
zle -N atuin-fzf-widget
bindkey '^R' atuin-fzf-widget

# --- Up/Down arrow: newest first; same host > rest. Reads atuin DB directly ---
typeset -ga _ATUIN_UP_LIST
typeset -gi _ATUIN_UP_IDX=0
typeset -g  _ATUIN_UP_ORIG=""
_ATUIN_DB="${XDG_DATA_HOME:-$HOME/.local/share}/atuin/history.db"

_atuin_up_local() {
    emulate -L zsh
    # Rebuild the list on the first press of a sequence
    if [[ $LASTWIDGET != _atuin_up_local && $LASTWIDGET != _atuin_down_local ]]; then
        _ATUIN_UP_ORIG=$BUFFER
        _ATUIN_UP_LIST=("${(@f)$(sqlite3 -readonly "$_ATUIN_DB" "
            SELECT command FROM history
            WHERE deleted_at IS NULL
              AND length(command) > 1
              AND command NOT LIKE '%' || char(10) || '%'
              AND exit != 127
            GROUP BY command
            ORDER BY MAX(hostname = '$_ATUIN_HOST_ID') DESC,
                     MAX(timestamp) DESC
            LIMIT 200;" 2>/dev/null)}")
        _ATUIN_UP_IDX=0
    fi
    # Empty list: fall back to normal zsh behaviour
    if [[ -z ${_ATUIN_UP_LIST[1]} ]]; then
        zle up-line-or-history
        return
    fi
    (( _ATUIN_UP_IDX < $#_ATUIN_UP_LIST )) && (( _ATUIN_UP_IDX++ ))
    BUFFER=${_ATUIN_UP_LIST[_ATUIN_UP_IDX]}
    CURSOR=$#BUFFER
}

_atuin_down_local() {
    emulate -L zsh
    if (( _ATUIN_UP_IDX > 1 )); then
        (( _ATUIN_UP_IDX-- ))
        BUFFER=${_ATUIN_UP_LIST[_ATUIN_UP_IDX]}
    else
        _ATUIN_UP_IDX=0
        BUFFER=$_ATUIN_UP_ORIG   # restore what you were typing
    fi
    CURSOR=$#BUFFER
}

zle -N _atuin_up_local
zle -N _atuin_down_local
bindkey '^[[A' _atuin_up_local;   bindkey '^[OA' _atuin_up_local
bindkey '^[[B' _atuin_down_local; bindkey '^[OB' _atuin_down_local
