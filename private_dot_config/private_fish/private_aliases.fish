# Navigation
alias .. "cd .."
alias ... "cd ../.."

# List
alias ls "lsd"
alias la "lsd -A"
alias ll "lsd -lh"
alias lla "lsd -Al"
alias g git
alias cls clear
alias vi nvim

# Global
alias myip "curl ifconfig.me"
alias rmf "rm -rf"
alias wget "wget -c -P ~/Downloads"
alias ccd "chezmoi cd"
alias gs "git status"

# Human readable size files
alias df "df -h"
alias du "du -h"
alias free "free -h"

# Uptime
alias uptime "uptime -p"

# alias for editing with sudo
alias svi "sudoedit"

